# ==============================================================================
# with.security - 환경 설정 예시 템플릿 (.env.example)
# 실제 운영 시 이 파일을 복사하여 .env 파일을 생성하고 실제 값을 입력하세요.
# ==============================================================================

# [1] 가비아 MySQL 데이터베이스 접속 설정 (Gabia MySQL DB Config)
# 가비아 My가비아 > 호스팅 관리콘솔 > DB 관리에서 확인한 정보를 입력합니다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_gabia_db_user
DB_PASSWORD=your_gabia_db_password
DB_NAME=your_gabia_db_name

# [2] 백엔드 Node.js API 서버 설정
# 가비아 가상서버/컨테이너에서 실행할 포트 (기본 4000)
PORT=4000
NODE_ENV=production

# [3] 프론트엔드 및 모바일 어플리케이션 연동 API 주소 (Vite)
# 가비아에서 도메인을 연결한 후의 웹/API 주소를 입력합니다. (예: https://your-domain.co.kr)
VITE_API_URL=http://localhost:4000

# [4] 가비아 웹호스팅 보안 & CORS 설정 (Gabia Web Security)
# 허용할 도메인 목록 (쉼표로 구분, * 지정 시 전체 허용)
ALLOWED_ORIGINS=https://your-domain.co.kr,capacitor://localhost,http://localhost:5173
DB_CONNECTION_LIMIT=10

# [5] 엔터프라이즈 보안 및 JWT 토큰 암호화 키 (HMAC-SHA256)
JWT_SECRET=your_super_secret_jwt_key_2026_change_this_in_production
API_SECRET_KEY=your_enterprise_api_secret_key_here

# [6] 기본 관리자(Admin) 보안 계정 설정
ADMIN_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=your_strong_admin_password!
VITE_ADMIN_DEFAULT_PASSWORD=your_strong_admin_password!