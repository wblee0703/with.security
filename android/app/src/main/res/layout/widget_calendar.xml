<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="12dp">

    <!-- 1. Header: App Logo & Month Title & Prev/Next & Refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🛡️ with.security"
            android:textColor="#0284C7"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Month Navigation: Prev, Title, Next, Refresh -->
        <TextView
            android:id="@+id/btn_prev_month"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_nav_btn"
            android:gravity="center"
            android:text="◀"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/tv_month_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:text="2026년 9월"
            android:textColor="#0F172A"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btn_next_month"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:background="@drawable/widget_nav_btn"
            android:gravity="center"
            android:text="▶"
            android:textColor="#334155"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="26dp"
            android:layout_height="24dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_nav_btn"
            android:gravity="center"
            android:text="🔄"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 2. Days of Week Header Row (일 월 화 수 목 금 토) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="3dp">

        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="일" android:textColor="#DC2626" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="월" android:textColor="#64748B" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="화" android:textColor="#64748B" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:text="수" android:textColor="#64748B" android:textSize="10sp" android:textStyle="bold" />
