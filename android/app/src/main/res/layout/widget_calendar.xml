    <!-- 4. Today Work Summary Card at Bottom (Tap to Open App) -->
    <LinearLayout
        android:id="@+id/layout_today_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/widget_summary_bg"
        android:padding="8dp"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tv_today_date_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📌 오늘 업무 일정"
                android:textColor="#0369A1"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_today_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TBM 완료"
                android:textColor="#16A34A"
                android:textSize="10sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_today_work_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="등록된 일일업무를 확인하려면 터치하세요"
            android:textColor="#334155"
